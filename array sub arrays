'''longest sub array with sum k '''
arr = [10, 5, 2, 7, 1, 9]
k = 15
freq = {}
total = 0
longest = 0
for i in range(len(arr)):
    total += arr[i]
    if total == k:
        longest = i + 1
    if total - k in freq:
        length = i - freq[total - k]
        longest = max(longest, length)
    if total not in freq:
        freq[total] = i
print(longest)
