'''move positives and negitives alternatly'''
nums = [1, 2, -3, -4, 5, -6]
positive = []
negative = []
for x in nums:
    if x >= 0:
        positive.append(x)
    else:
        negative.append(x)
result = []
for i in range(max(len(positive), len(negative))):
    if i < len(positive):
        result.append(positive[i])
    if i < len(negative):
        result.append(negative[i])
print(result)
